{
  "info": {
    "name": "Medi-Agua - Forgot Password API",
    "description": "Colección de pruebas para el endpoint POST /api/forgot-password",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    }
  ],
  "item": [
    {
      "name": "Correo Existente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["forgot-password"]
        }
      },
      "response": {
        "status": "OK",
        "code": 200,
        "body": "{\n  \"success\": true,\n  \"message\": \"Si el correo existe, se enviará un enlace para restablecer la contraseña.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    },
    {
      "name": "Correo Inexistente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["forgot-password"]
        }
      },
      "response": {
        "status": "OK",
        "code": 200,
        "body": "{\n  \"success\": true,\n  \"message\": \"Si el correo existe, se enviará un enlace para restablecer la contraseña.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    },
    {
      "name": "Email Inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["forgot-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"email\": [\n      \"El correo electrónico debe ser una dirección de correo válida.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Campo Vacío",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["forgot-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"email\": [\n      \"El campo de correo electrónico es obligatorio.\"\n    ]\n  }\n}"
      }
    }
  ]
}
