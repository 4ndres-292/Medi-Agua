{
  "info": {
    "name": "Medi-Agua - Reset Password API",
    "description": "Colección de pruebas para el endpoint POST /api/reset-password",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "reset_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pre-Requisito: Obtener Token de Reset",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "console.log('Check storage/logs/laravel.log for the token');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["forgot-password"]
        }
      }
    },
    {
      "name": "Reset Exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/reset-password",
          "host": ["{{base_url}}"],
          "path": ["reset-password"]
        }
      },
      "response": {
        "status": "OK",
        "code": 200,
        "body": "{\n  \"success\": true,\n  \"message\": \"Contraseña restablecida correctamente.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    },
    {
      "name": "Token Inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"invalid-token-12345\",\n  \"email\": \"test@example.com\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/reset-password",
          "host": ["{{base_url}}"],
          "path": ["reset-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"success\": false,\n  \"message\": \"No se pudo restablecer la contraseña. El token puede ser inválido o haber expirado.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    },
    {
      "name": "Confirmación No Coincide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"different123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/reset-password",
          "host": ["{{base_url}}"],
          "path": ["reset-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"password\": [\n      \"La confirmación de contraseña no coincide.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Contraseña Muy Corta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"short\",\n  \"password_confirmation\": \"short\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/reset-password",
          "host": ["{{base_url}}"],
          "path": ["reset-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"password\": [\n      \"La contraseña debe tener al menos 8 caracteres.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Campos Obligatorios Vacíos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/reset-password",
          "host": ["{{base_url}}"],
          "path": ["reset-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"token\": [\n      \"El token de restablecimiento es obligatorio.\"\n    ],\n    \"email\": [\n      \"El campo de correo electrónico es obligatorio.\"\n    ],\n    \"password\": [\n      \"El campo de contraseña es obligatorio.\"\n    ]\n  }\n}"
      }
    }
  ]
}
