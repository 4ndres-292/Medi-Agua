{
  "info": {
    "name": "Medi-Agua - Change Password API",
    "description": "Colección de pruebas para el endpoint POST /api/change-password",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pre-Requisito: Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.environment.set('token', jsonData.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cambio Exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"12345678\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "OK",
        "code": 200,
        "body": "{\n  \"success\": true,\n  \"message\": \"Contraseña actualizada correctamente.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    },
    {
      "name": "Contraseña Actual Incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"wrongpassword\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"current_password\": [\n      \"La contraseña actual no es correcta.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Confirmación No Coincide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"12345678\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"different123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"password\": [\n      \"La confirmación de contraseña no coincide.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Contraseña Muy Corta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"12345678\",\n  \"password\": \"short\",\n  \"password_confirmation\": \"short\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"password\": [\n      \"La nueva contraseña debe tener al menos 8 caracteres.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Campos Obligatorios Vacíos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "Unprocessable Entity",
        "code": 422,
        "body": "{\n  \"message\": \"Los datos proporcionados no son válidos.\",\n  \"errors\": {\n    \"current_password\": [\n      \"El campo de contraseña actual es obligatorio.\"\n    ],\n    \"password\": [\n      \"El campo de nueva contraseña es obligatorio.\"\n    ]\n  }\n}"
      }
    },
    {
      "name": "Sin Token (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"12345678\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/change-password",
          "host": ["{{base_url}}"],
          "path": ["change-password"]
        }
      },
      "response": {
        "status": "Unauthorized",
        "code": 401,
        "body": "{\n  \"success\": false,\n  \"message\": \"Unauthenticated.\",\n  \"data\": null,\n  \"errors\": null\n}"
      }
    }
  ]
}
